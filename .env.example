# Copie para .env e preencha. O .env NUNCA vai para o Git.

# Supabase — Project Settings > API
SUPABASE_URL=
SUPABASE_KEY=

# Ambiente da aplicacao: local | staging | production
APP_ENV=local

# Segredo de assinatura dos JWTs (Supabase > Settings > API > JWT Secret).
# Obrigatorio quando APP_ENV != local; sem ele a API subiria aceitando qualquer token.
SUPABASE_JWT_SECRET=

# Origens liberadas no CORS fora do local, separadas por virgula em JSON.
# Ex.: ORIGENS_PERMITIDAS=["https://claudinho.app"]
ORIGENS_PERMITIDAS=[]
