# Copie para .env e preencha. O .env NUNCA vai para o Git.

# Supabase — Project Settings > API
# Apenas o host do projeto, sem barra e sem caminho no fim.
# Certo:  https://xxxxxxxx.supabase.co
# Errado: https://xxxxxxxx.supabase.co/rest/v1/   (o client ja acrescenta /rest/v1)
SUPABASE_URL=
SUPABASE_KEY=

# Ambiente da aplicacao: local | staging | production
# local: aceita qualquer token (SO desenvolvimento). Em producao use production: e o
# padrao do codigo justamente para que esquecer esta variavel falhe FECHADO.
APP_ENV=local

# LLM proprio: Ollama no Hugging Face Spaces (ver deploy/ollama-space/README.md).
# URL ate o /v1. Ex.: https://usuario-claudinho-llm.hf.space/v1
LLM_BASE_URL=
LLM_MODELO=qwen2.5:3b
# Token do Hugging Face (leitura), necessario quando o Space e privado.
LLM_API_KEY=
LLM_TIMEOUT_S=90

# Reservas externas, usadas so quando o LLM proprio falha. Nunca recebem dado de saude.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite
OPENAI_API_KEY=
# Segredo de assinatura dos JWTs do Supabase Auth (Project Settings > API > JWT Secret).
# SO para projeto antigo, que assina com HS256. Projetos criados desde outubro de 2025 usam
# chave assimetrica, e a API valida pelas chaves publicas do SUPABASE_URL, sem segredo.
# Quem decide se o token e validado e o APP_ENV, e nao esta variavel.
SUPABASE_JWT_SECRET=

# Origens liberadas no CORS fora do ambiente local, em lista JSON.
# Obrigatorio quando APP_ENV != local: sem ela o navegador bloqueia as chamadas do app.
# Ex.: ORIGENS_PERMITIDAS=["https://claudinho.app"]
ORIGENS_PERMITIDAS=[]

# Embeddings remotos. Obrigatorio em producao (Vercel/Render); vazio = modelo local, que
# exige `uv pip install -r requirements-ml.txt`.
# Em producao, use a API de inferencia do Hugging Face (nao precisa de Space):
#   https://router.huggingface.co/hf-inference/models/intfloat/multilingual-e5-base/pipeline/feature-extraction
# com um token que tenha a permissao "Make calls to Inference Providers".
# Localmente, deixe vazio: o modelo roda na sua maquina e nao gasta a cota gratuita.
EMBEDDINGS_URL=
EMBEDDINGS_PROVEDOR=hf-inference
EMBEDDINGS_TOKEN=
