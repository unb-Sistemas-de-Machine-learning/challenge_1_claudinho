# Copie para .env.local e ajuste. O .env.local NUNCA vai para o Git.

# Base da API. Em desenvolvimento com mock ligado, este valor nao e usado.
VITE_API_URL=http://127.0.0.1:8000

# Liga o mock da API (MSW). Com "true", o app roda sem backend, sem Supabase e sem LLM.
# E assim que da para trabalhar nas telas sem depender do pipeline estar de pe.
VITE_API_MOCK=true

# Token mandado no cabecalho Authorization. Serve SO para desenvolvimento local, onde a
# API aceita qualquer token com APP_ENV=local. Em producao ele e ignorado: o token vem do
# login anonimo do Supabase, em tempo de execucao.
VITE_API_TOKEN=token-de-desenvolvimento

# Sessao anonima (issue #23). OBRIGATORIAS em producao: sem elas o app manda o token fixo
# acima, e a API responde 401 em toda chamada.
# A anon key e publica de proposito (identifica o projeto, e o RLS que protege os dados).
# Nunca use a service_role aqui: tudo que comeca com VITE_ fica visivel no bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
